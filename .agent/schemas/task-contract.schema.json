{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/microsoft/SharePoint-Embedded-VS-Code-Extension/.agent/schemas/task-contract.schema.json",
  "title": "Agent Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "title",
    "goal",
    "baseBranch",
    "allowedPaths",
    "deniedPaths",
    "acceptanceCriteria",
    "requiredChecks",
    "workers",
    "authority",
    "limits",
    "requiredArtifacts"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120
    },
    "goal": {
      "type": "string",
      "minLength": 20
    },
    "baseBranch": {
      "type": "string",
      "minLength": 1
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repositoryPath"
      }
    },
    "deniedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/repositoryPath"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/acceptanceCriterion"
      }
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/requiredCheck"
      }
    },
    "workers": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/definitions/worker"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyFile",
        "approvalRequiredFor"
      ],
      "properties": {
        "policyFile": {
          "$ref": "#/definitions/repositoryPath"
        },
        "approvalRequiredFor": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "dependency-change",
              "authentication-scope-change",
              "telemetry-change",
              "security-boundary-change",
              "new-graph-beta-endpoint",
              "network-access",
              "live-cloud-mutation",
              "authority-expansion"
            ]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxConcurrentWorkers",
        "maxRepasses",
        "maxWallClockMinutes",
        "maxMinutesPerWorker",
        "maxAiCreditsPerWorker",
        "maxAutopilotContinues"
      ],
      "properties": {
        "maxConcurrentWorkers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxRepasses": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maxWallClockMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480
        },
        "maxMinutesPerWorker": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "maxAiCreditsPerWorker": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1000
        },
        "maxAutopilotContinues": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "maxTokensPerWorker": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "worker-results",
          "integration-result",
          "validation-results",
          "review-result",
          "repass-results",
          "pull-request"
        ]
      }
    }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$"
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[0-9]{2,}$"
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "evidence": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "requiredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "command",
        "timeoutMinutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "command": {
          "type": "string",
          "minLength": 3
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "agent",
        "roleFile",
        "isolation",
        "mayEdit",
        "allowedPaths",
        "dependsOn",
        "contextInputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {
          "type": "string",
          "enum": [
            "implementer",
            "sdet",
            "integrator",
            "reviewer"
          ]
        },
        "agent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "roleFile": {
          "$ref": "#/definitions/repositoryPath"
        },
        "isolation": {
          "type": "string",
          "enum": [
            "git-worktree",
            "read-only-checkout"
          ]
        },
        "mayEdit": {
          "type": "boolean"
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/repositoryPath"
          }
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "contextInputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "task-contract",
              "agents-instructions",
              "authority-policy",
              "baseline-source",
              "worker-results",
              "worker-commits",
              "integrated-diff",
              "validation-results"
            ]
          }
        }
      }
    }
  }
}
