{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/microsoft/SharePoint-Embedded-VS-Code-Extension/.agent/schemas/review-result.schema.json",
  "title": "Independent Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "workerId",
    "reviewedCommit",
    "decision",
    "summary",
    "criteria",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "reviewedCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "changes-required",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]{2,}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "not-satisfied",
              "not-verifiable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "category",
          "criterionIds",
          "rationale",
          "evidence",
          "repassInstruction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{2,}$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "high",
              "medium",
              "low"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "reliability",
              "testing",
              "architecture",
              "contract"
            ]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "criterionIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^AC-[0-9]{2,}$"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "evidence": {
            "type": "string",
            "minLength": 5
          },
          "repassInstruction": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "changes-required"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
